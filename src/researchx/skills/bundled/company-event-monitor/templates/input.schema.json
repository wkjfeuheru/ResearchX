{
  "$defs": {
    "Channel": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "state": {
          "enum": [
            "ok",
            "failed",
            "stale",
            "summary_only"
          ],
          "title": "State",
          "type": "string"
        },
        "detail": {
          "default": "",
          "title": "Detail",
          "type": "string"
        }
      },
      "required": [
        "name",
        "state"
      ],
      "title": "Channel",
      "type": "object"
    },
    "Company": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "code": {
          "pattern": "^\\d{6}$",
          "title": "Code",
          "type": "string"
        },
        "market": {
          "enum": [
            "SSE",
            "SZSE",
            "BSE"
          ],
          "title": "Market",
          "type": "string"
        },
        "industry": {
          "minLength": 1,
          "title": "Industry",
          "type": "string"
        },
        "financial_sector": {
          "default": false,
          "title": "Financial Sector",
          "type": "boolean"
        },
        "identity_sources": {
          "items": {
            "$ref": "#/$defs/Reference"
          },
          "minItems": 1,
          "title": "Identity Sources",
          "type": "array"
        }
      },
      "required": [
        "name",
        "code",
        "market",
        "industry",
        "identity_sources"
      ],
      "title": "Company",
      "type": "object"
    },
    "Event": {
      "additionalProperties": false,
      "properties": {
        "event_key": {
          "description": "Stable company/category/event identity, not article URL",
          "minLength": 1,
          "title": "Event Key",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "occurred_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Occurred At"
        },
        "published_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Published At"
        },
        "category": {
          "enum": [
            "merger",
            "shareholding",
            "earnings_guidance",
            "financial_report",
            "financing_dividend",
            "litigation_regulation",
            "operating_contract",
            "management",
            "other"
          ],
          "title": "Category",
          "type": "string"
        },
        "summary": {
          "title": "Summary",
          "type": "string"
        },
        "references": {
          "items": {
            "$ref": "#/$defs/Reference"
          },
          "minItems": 1,
          "title": "References",
          "type": "array"
        },
        "sentiment": {
          "$ref": "#/$defs/Score"
        },
        "impact": {
          "$ref": "#/$defs/Score"
        },
        "summary_only": {
          "default": false,
          "title": "Summary Only",
          "type": "boolean"
        }
      },
      "required": [
        "event_key",
        "title",
        "category",
        "summary",
        "references",
        "sentiment",
        "impact"
      ],
      "title": "Event",
      "type": "object"
    },
    "Reference": {
      "additionalProperties": false,
      "properties": {
        "locator": {
          "minLength": 1,
          "title": "Locator",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "source_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Id"
        },
        "evidence_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidence Id"
        },
        "page": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page"
        },
        "published_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Published At"
        },
        "excerpt": {
          "default": "",
          "title": "Excerpt",
          "type": "string"
        }
      },
      "required": [
        "locator",
        "title"
      ],
      "title": "Reference",
      "type": "object"
    },
    "Score": {
      "additionalProperties": false,
      "properties": {
        "value": {
          "anyOf": [
            {
              "maximum": 2,
              "minimum": -2,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low"
          ],
          "title": "Confidence",
          "type": "string"
        }
      },
      "required": [
        "value",
        "reason",
        "confidence"
      ],
      "title": "Score",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": 1,
      "enum": [
        1,
        2,
        3
      ],
      "title": "Schema Version",
      "type": "integer"
    },
    "company": {
      "$ref": "#/$defs/Company"
    },
    "inputs": {
      "items": {
        "$ref": "#/$defs/Reference"
      },
      "minItems": 1,
      "title": "Inputs",
      "type": "array"
    },
    "status": {
      "default": "partial",
      "enum": [
        "complete",
        "partial",
        "blocked"
      ],
      "title": "Status",
      "type": "string"
    },
    "gaps": {
      "items": {
        "type": "string"
      },
      "title": "Gaps",
      "type": "array"
    },
    "as_of": {
      "format": "date-time",
      "title": "As Of",
      "type": "string"
    },
    "kind": {
      "const": "monitor",
      "default": "monitor",
      "title": "Kind",
      "type": "string"
    },
    "window_start": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Window Start"
    },
    "events": {
      "items": {
        "$ref": "#/$defs/Event"
      },
      "title": "Events",
      "type": "array"
    },
    "undated_events": {
      "items": {
        "$ref": "#/$defs/Event"
      },
      "title": "Undated Events",
      "type": "array"
    },
    "outside_window": {
      "items": {
        "$ref": "#/$defs/Event"
      },
      "title": "Outside Window",
      "type": "array"
    },
    "channels": {
      "items": {
        "$ref": "#/$defs/Channel"
      },
      "minItems": 1,
      "title": "Channels",
      "type": "array"
    }
  },
  "required": [
    "company",
    "inputs",
    "as_of",
    "channels"
  ],
  "title": "MonitorResult",
  "type": "object"
}
