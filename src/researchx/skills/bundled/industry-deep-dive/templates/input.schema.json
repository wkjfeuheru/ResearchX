{
  "$defs": {
    "Claim": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "kind": {
          "default": "unclassified",
          "enum": [
            "fact",
            "inference",
            "forecast",
            "unclassified"
          ],
          "title": "Kind",
          "type": "string"
        },
        "references": {
          "items": {
            "$ref": "#/$defs/Reference"
          },
          "minItems": 1,
          "title": "References",
          "type": "array"
        },
        "observation_ids": {
          "items": {
            "type": "string"
          },
          "title": "Observation Ids",
          "type": "array"
        },
        "conclusion_id": {
          "default": "",
          "title": "Conclusion Id",
          "type": "string"
        },
        "reasoning_summary": {
          "default": "",
          "title": "Reasoning Summary",
          "type": "string"
        },
        "model_run_id": {
          "default": "",
          "title": "Model Run Id",
          "type": "string"
        },
        "output_id": {
          "default": "",
          "title": "Output Id",
          "type": "string"
        }
      },
      "required": [
        "text",
        "references"
      ],
      "title": "Claim",
      "type": "object"
    },
    "Metric": {
      "additionalProperties": false,
      "description": "Quote an upstream value with exact contextual field pointers (JSON Pointer).",
      "properties": {
        "label": {
          "title": "Label",
          "type": "string"
        },
        "upstream": {
          "title": "Upstream",
          "type": "string"
        },
        "pointers": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Pointers",
          "type": "object"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        },
        "unit": {
          "title": "Unit",
          "type": "string"
        },
        "period": {
          "title": "Period",
          "type": "string"
        },
        "scope": {
          "title": "Scope",
          "type": "string"
        },
        "currency": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Currency"
        },
        "references": {
          "items": {
            "$ref": "#/$defs/Reference"
          },
          "minItems": 1,
          "title": "References",
          "type": "array"
        },
        "missing_reason": {
          "default": "",
          "title": "Missing Reason",
          "type": "string"
        }
      },
      "required": [
        "label",
        "upstream",
        "pointers",
        "value",
        "unit",
        "period",
        "scope",
        "references"
      ],
      "title": "Metric",
      "type": "object"
    },
    "Reference": {
      "additionalProperties": false,
      "properties": {
        "locator": {
          "minLength": 1,
          "title": "Locator",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "source_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Id"
        },
        "evidence_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidence Id"
        },
        "page": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page"
        },
        "published_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Published At"
        },
        "excerpt": {
          "default": "",
          "title": "Excerpt",
          "type": "string"
        }
      },
      "required": [
        "locator",
        "title"
      ],
      "title": "Reference",
      "type": "object"
    },
    "Section": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "title": "Key",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "paragraphs": {
          "items": {
            "$ref": "#/$defs/Claim"
          },
          "title": "Paragraphs",
          "type": "array"
        },
        "gaps": {
          "items": {
            "type": "string"
          },
          "title": "Gaps",
          "type": "array"
        }
      },
      "required": [
        "key",
        "title"
      ],
      "title": "Section",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 3,
      "default": 3,
      "title": "Schema Version",
      "type": "integer"
    },
    "kind": {
      "const": "industry-deep-dive",
      "default": "industry-deep-dive",
      "title": "Kind",
      "type": "string"
    },
    "subject": {
      "minLength": 1,
      "title": "Subject",
      "type": "string"
    },
    "as_of": {
      "format": "date-time",
      "title": "As Of",
      "type": "string"
    },
    "inputs": {
      "items": {
        "$ref": "#/$defs/Reference"
      },
      "title": "Inputs",
      "type": "array"
    },
    "upstream_results": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Upstream Results",
      "type": "object"
    },
    "sections": {
      "items": {
        "$ref": "#/$defs/Section"
      },
      "title": "Sections",
      "type": "array"
    },
    "metrics": {
      "items": {
        "$ref": "#/$defs/Metric"
      },
      "title": "Metrics",
      "type": "array"
    },
    "status": {
      "default": "partial",
      "enum": [
        "complete",
        "partial",
        "blocked"
      ],
      "title": "Status",
      "type": "string"
    },
    "gaps": {
      "items": {
        "type": "string"
      },
      "title": "Gaps",
      "type": "array"
    }
  },
  "required": [
    "subject",
    "as_of"
  ],
  "title": "ReportResult",
  "type": "object"
}
